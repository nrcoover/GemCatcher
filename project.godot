; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GemCadet"
config/description="A simple arcade-style catching game developed by Nicklefritz using Godot 4.5.2 with C#."
run/main_scene="uid://cr3xrjvpb4sfi"
config/features=PackedStringArray("4.5", "C#", "Mobile")
config/icon="uid://d1oy1mgl4kmo6"

[autoload]

SignalManager="*res://globals/SignalManager.cs"
GameManager="*res://globals/GameManager.cs"
LevelManager="*res://globals/LevelManager.cs"
SaveDataManager="*res://globals/SaveDataManager.cs"
UiInputManager="*res://globals/UIInputManager.cs"

[debug]

shapes/collision/shape_color=Color(1.1462169, 0.14035626, 0.70538086, 0.57500005)

[display]

window/size/mode=3
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="GemCatcher"

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

[global_group]

"Moveable Objects"="Objects that move."
"Audio Streams"="All audio streams"

