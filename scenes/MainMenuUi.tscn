[node name="Title" parent="Modals/CreditsModal/MarginOuter/Panel/MarginInner/VBoxContainer/HBoxTitle" index="0"]
text = "CREDITS"

[node name="Instructions" parent="Modals/CreditsModal/MarginOuter/Panel/MarginInner/VBoxContainer/HBoxInstructions" index="0"]
text = "This game was created as a student project and is an expansion upon an original game created by following the Udemy Course \"Learn 2D Game Development: Godot 4.5 & C# from Scratch\" by Richard Allbert and Martyna Olivares. Assets are sourced, royalty free, from Kenny Assets and Pexels.com. Recorded dialogue clips are original recordings by the game developer, \"Nicklefritz\", distributed under the alias: \"Fritzie Games\"."
horizontal_alignment = 3

[node name="CloseButton" parent="Modals/CreditsModal/MarginOuter/Panel/MarginInner/VBoxContainer/HBoxButtonWrapper/HBoxButton" index="0"]
texture_disabled = ExtResource("4_56fvm")

[node name="HelloModal" parent="Modals" instance=ExtResource("4_h6icy")]
visible = false
layout_mode = 1

[node name="Title" parent="Modals/HelloModal/MarginOuter/Panel/MarginInner/VBoxContainer/HBoxTitle" index="0"]
text = "MEET THE DEVELOPER"

[node name="Instructions" parent="Modals/HelloModal/MarginOuter/Panel/MarginInner/VBoxContainer/HBoxInstructions" index="0"]
text = "Hello! I'm Nicklefritz, I built this game, and if you want to follow my game dev journey, you can! The buttons below will take you to my various social medias and website! Why not come say \"hello\"? Also, you can stop by my YouTube channels: \"NicklefritzDev\" for my game dev work and \"Nicklefritz\" for my Let's Play content! Thanks again for playing, and most importantly: Thank you for being you!"
horizontal_alignment = 3

